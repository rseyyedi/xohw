ADDRESS_MAP flight_controller_flight_controller_mb MICROBLAZE-LE 100 flight_controller/flight_controller_mb
   ADDRESS_SPACE flight_controller_flight_controller_local_memory_lmb_bram_128K_1_ADDR_SPACE flight_controller_flight_controller_local_memory_lmb_bram_128K_1_MEM_DEVICE  [0x00000000:0x0001FFFF] flight_controller/flight_controller_local_memory/dlmb_bram_if_cntlr
