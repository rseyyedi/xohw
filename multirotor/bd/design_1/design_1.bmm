   ADDRESS_SPACE blk_mem_gen_sa_fc_4K_3_ADDR_SPACE blk_mem_gen_sa_fc_4K_3_MEM_DEVICE  [0xC0000000:0xC0000FFF] sensor_actor/axi_bram_ctrl_sa
     BUS_BLOCK
      blk_mem_gen_sa_fc_4K_3_BUS_BLK [31:0] INPUT = "design_1_blk_mem_gen_sa_fc_0.mem";
